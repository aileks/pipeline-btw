AIRFLOW_UID=1000
# used by host-side runs (psql, python); containers get their own DB_URL from docker-compose.yaml
DB_URL="postgresql://user@127.0.0.1:5432/dbname"

# overrides the DB_URL that DAG code sees inside the containers; defaults to the stack's postgres
#PIPELINE_DB_URL=postgresql://user@host.containers.internal:5432/dbname

# pip deps installed into the airflow containers at startup; DAG code importing
# pipeline_btw needs psycopg (the image only ships psycopg2)
#_PIP_ADDITIONAL_REQUIREMENTS=psycopg

# optional: encrypts saved connections; generate with
#   podman run --rm docker.io/apache/airflow:3.3.1 python -c \
#     "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#FERNET_KEY=

# optional: web UI credentials created on first startup (defaults airflow/airflow)
#_AIRFLOW_WWW_USER_USERNAME=airflow
#_AIRFLOW_WWW_USER_PASSWORD=airflow

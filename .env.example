# local path (airflow in the venv)
AIRFLOW_HOME=.airflow
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://user@127.0.0.1:5432/airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__DAGS_FOLDER=./dags
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_USERS=admin:your_password

# pipeline database used by DAG code and host-side runs (psql, python)
DB_URL="postgresql://user@127.0.0.1:5432/breweries"

# docker compose path only: the compose file sets its own DB_URL for DAG code
AIRFLOW_UID=1000
# only needed when running the stock airflow image; the extended image (Dockerfile)
# already bakes in the deps pipeline_btw imports
#_PIP_ADDITIONAL_REQUIREMENTS="httpx psycopg psycopg-binary pydantic python-dotenv"

# optional: encrypts saved connections; airflow generates one when unset
#FERNET_KEY=
